# Candidate only. Use a trusted TLS certificate covering the hostname/IP the phone uses.
CRYPTOG_LIBRARY_DIR=/opt/shotcrypto-stage1/model_library
CRYPTOG_LOG_DIR=/opt/shotcrypto-stage1/logs
CRYPTOG_DEVICE_AUTH_FILE=/etc/shotcrypto/devices.json
CRYPTOG_TLS_CERT=/etc/shotcrypto/tls/fullchain.pem
CRYPTOG_TLS_KEY=/etc/shotcrypto/tls/privkey.pem
CRYPTOG_FCM_KEY_PATH=/etc/shotcrypto/firebase.json
CRYPTOG_API_BIND=0.0.0.0
CRYPTOG_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# Keep disabled for shadow collection. Enabling requires separate release authorization.
CRYPTOG_ENABLE_BASELINE_ALERTS=0
# Independent device-directed exit transport, disabled until separately authorized.
CRYPTOG_ENABLE_EXIT_ALERTS=0
